# Copiar a supabase/.env.local (ignorado por git) y completar. NUNCA subir valores reales.
# Local: supabase functions serve --env-file supabase/.env.local
ALLOWED_ORIGINS=http://localhost:8123,http://127.0.0.1:8123
# Generar con: openssl rand -base64 48   (mínimo 32 caracteres)
HASH_SALT=
# Cabecera con la IP real. En local no hay proxy de Supabase: las pruebas la mandan a mano.
# En el proyecto real se fija con la cabecera que resulte de la prueba D (ver plan).
IP_HEADER=x-forwarded-for
# Local: Kong agrega su propia IP a la derecha de X-Forwarded-For, por eso 2.
IP_DESDE_DERECHA=2
